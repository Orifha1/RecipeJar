<% layout('layouts/boilerplate')%>

<h1 class="text-center">Update Profile</h1>
<div class="row d-flex justify-content-center container p-3 formStyling" id="formContent">
<form action="/users/<%=user._id%>?_method=PUT" method="POST" class="validated-form border border-dark p-5 p-3 rounded col-sm-12 col-md-9" novalidate class="validated-form" enctype="multipart/form-data">
    <div class="mb-3">
        <label class="form-label" for="username">Username *</label>
        <input class="form-control" type="text" id="username" name="user[username]" value="<%=user.username %>" required>
        <div class="valid-feedback">
            Looks good!
        </div>
    </div>
    <div class="mb-3">
        <button class="btn btn-info">Update Profile</button>
    </div>
    <a href="/users/<%= user._id%>">Back To Profile</a>
</form>

</div>