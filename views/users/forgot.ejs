<% layout('layouts/boilerplate')%>
	<div class="d-flex justify-content-center container p-3">
		<form action="/forgot" method="POST" class="validated-form border border-dark p-5 w-75 p-3 rounded" novalidate>
			<legend>Forgot Password</legend>
			<div class="form-group mb-3">
				<label class="form-label" for="email">Email *</label>
				<input class="form-control" type="email" id="email" name="email" autofocus class="form-control" required>
				<div class="valid-feedback">
					Looks good!
				</div>
			</div>
			<div class="form-group">
				<input type="submit" class="btn btn-primary" value="Reset Password">
			</div>
		</form>
	</div>
