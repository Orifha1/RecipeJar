<% layout('layouts/boilerplate')%>
    <h1 class="text-center">All Recipes</h1>
    <hr>
<div class="row" style="width: 85%; margin: auto;">
    <div class="col-sm-6 col-md-4 mb-3 ml-1" >

            <form action="/recipes" method="GET" class="form-inline d-flex  md-form form-sm mb-1 w-25 float-right">
                <input class="form-control form-control-sm mr-3" type="text" style="width: 170px;"  name="search" placeholder="Search..."
                  aria-label="Search">
                  <input type="submit" value="Search" class="btn btn-outline-secondary">
              </form>
    </div>
</div>

    <ul class="justify-content-center overflow-auto">
            <div class="row" style="width: 85%; margin: auto;">
                <%for(let recipe of recipes) {%>
                <div class="col-sm-6 col-md-4 mb-3 ml-1">
                    <div class="card text-justify shadow" style="width: 20rem;" id="cardRecipes">
                        <img class="card-img-top img-responsive" id="cardImage" alt="" src="<%=recipe.images[0].url%>">
                        <div class="card-body d-flex flex-column overflow-hidden">
                            <h5 class="card-title"><%= recipe.title %> </h5>
                            <p class="card-text" id="cardRecipesPar"><%= recipe.description %></p>
                            <em>Submitted By: <a  href="/users/<%= recipe.author._id %>"><%= recipe.author.username %></em></a>
                            <div class="mt-auto p-1">
                                <p class="card-text">
                                    <small class="text-muted"><%= recipe.location%></small>
                                </p> 
                                <a class="btn btn-primary" style="width: 100%;" href="/recipes/<%=recipe._id%>">View <%=recipe.title%></a>
                            </div>
                        </div>
                    </div>
                </div>
                <% } %>
            </div>

            <a href="/recipes/new" class="material-icons floating-btn">add</a>
            <div class="label-container">
                <div class="label-text">Add Recipe</div>
                <i class="fa fa-play label-arrow"></i>
            </div>

        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
            <% if(page > 1) {%>
                <li class="page-item">
                    <a class="page-link" href="/recipes?page=<%= page - 1 %>" tabindex="-1">Previous</a>
                </li>
              <% } %>

              <li class="page-item">
                <a class="page-link" href="/recipes?page=<%= page + 1 %>">Next</a>
              </li>
            </ul>
          </nav>
    </ul>
    <%- include('../partials/footer')%>
