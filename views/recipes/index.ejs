                            <p class="card-text">
                                <small class="text-muted"><%= recipe.location%></small>
                            </p>
                            <a class="btn btn-primary" href="/recipes/<%=recipe._id%>">View <%=recipe.title%></a>
                        </div>
                    </div>
                </div>
            </div>
        <% } %> -->

        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
            <% if(page > 1) {%>
                <li class="page-item">
                    <a class="page-link" href="/recipes?page=<%= page - 1 %>" tabindex="-1">Previous</a>
                </li>
              <% } %>

              <li class="page-item">
                <a class="page-link" href="/recipes?page=<%= page + 1 %>">Next</a>
              </li>
            </ul>
          </nav>
    </ul>
    <%- include('../partials/footer')%>
