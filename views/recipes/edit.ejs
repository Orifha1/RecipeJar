<% layout('layouts/boilerplate')%>
<div class="row">
    <h1 class="text-center">Edit Recipe</h1>
    <div class="col-6 offset-3">
        <form action="/recipes/<%=recipe._id%>?_method=PUT" method="POST" novalidate class="validated-form">
            <div class="mb-3">
                <label class="form-label" for="title">Title</label>
                <input class="form-control" type="text" id="title" name="recipe[title]"
                    value="<%=recipe.title %>" required>
                    <div class="valid-feedback">
                        Looks good!
                      </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="location">Location</label>
                <input class="form-control" type="text" id="location" name="recipe[location]"
                    value="<%=recipe.location %>" required>
                    <div class="valid-feedback">
                        Looks good!
                      </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="image">Image Url</label>
                <input class="form-control" type="text" id="image" name="recipe[image]"
                    value="<%=recipe.image %>" required>
                    <div class="valid-feedback">
                        Looks good!
                      </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="price">recipe Price</label>
                <div class="input-group">
                    <span class="input-group-text" id="price-label">$</span>
                    <input type="text" class="form-control" id="price" placeholder="0.00" aria-label="price"
                        aria-describedby="price-label" name="recipe[price]" value="<%=recipe.price %>" required>
                        <div class="valid-feedback">
                            Looks good!
                          </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="description">Description</label>
                <textarea class="form-control" type="text" id="description"
                    name="recipe[description]" required><%= recipe.description%></textarea>
                    <div class="valid-feedback">
                        Looks good!
                      </div>
            </div>
            <div class="mb-3">
                <button class="btn btn-info">Update recipe</button>
            </div>
        </form>
        <a href="/recipes/<%= recipe._id%>">Back To recipe</a>

    </div>
</div>